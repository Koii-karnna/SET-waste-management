rules_version = '2';

// Paste this into Firebase console -> Firestore Database -> Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // users collection — read by any logged-in user, write only via Firebase Console
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // incomingRecords — viewer can read, editor can write
    match /incomingRecords/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor';
    }

    // outgoingRecords — viewer can read, editor can write
    match /outgoingRecords/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor';
    }

    // buildingOccupancy — monthly headcount per building; viewer can read, editor can write
    match /buildingOccupancy/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor';
    }
  }
}
